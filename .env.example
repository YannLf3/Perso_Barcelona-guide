APP_ENV=production
APP_URL=https://barcelonafeelgoodtours.eu
APP_KEY=
# IP des proxys de confiance (CDN), séparées par des virgules. Vide si aucun proxy.
TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=


# Comptes d'administration créés au démarrage de Docker (12 caractères minimum chacun).
# En production, ne rien mettre ici : utiliser `php bin/create-admin.php <identifiant> <admin|editor>`.
ADMIN_USER=admin
ADMIN_PASSWORD=
EDITOR_USER=
EDITOR_PASSWORD=
