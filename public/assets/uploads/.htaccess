# Dossier des photos envoyées depuis l'administration : seules les images sont servies, rien ne s'exécute
Options -Indexes -ExecCGI

RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht .cgi .pl .py .sh
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Require all denied

<FilesMatch "\.(?i:jpe?g|png|webp)$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
